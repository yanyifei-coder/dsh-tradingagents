# tradingagents-dsh 接入示例 —— 全部为注释；落地时按仓库真实插件校正字段后取消注释。
#
# DSH 有 verify-cordis-config 门禁：profile cordis.yml 中出现的裸插件必须登记在
# resolver manifest 的 dependencies 里。字段结构务必对照仓库内现有插件
# （建议对照 @deepseek-ai/dsh-jobs-local 与 @deepseek-ai/dsh-user-questions 的 cordis.yml）。
#
# 1) profile cordis.yml 的 include（形态对应 Config inspect 目录里的 include:<patchId> 条目）：
#
# include:
#   - tradingagents-dsh:
#       config:
#         selectedAnalysts: [market, news, sentiment, fundamentals]
#         maxDebateRounds: 1
#         maxRiskRounds: 1
#         decisionLanguage: 中文
#         dataDir: tradingagents-data
#         secEdgarUserAgent: "Your Name you@example.com"
#         stageTimeoutMs: 300000
#         memory:
#           maxInject: 3
#
# 2) 可选数据源凭据（FRED / Alpha Vantage / TypeSafe），运行时经 ctx.credentials.resolve
#    取值，绝不读环境变量：
#
#         optionalCredentialRefs:
#           alphaVantage: tradingagents.alphaVantageKey
#
# 注意：!!js 表达式只允许出现在 plugin config 与 entry disabled 之下；其余元数据保持字面量。
